local RoomManager = require "scripts.gameplay.room_manager"

function init(self)
	local manager = RoomManager.new()

	print("Current room:", RoomManager.get_current(manager))

	RoomManager.enter(manager, "village")

	print("Current room after enter:", RoomManager.get_current(manager))

	print("Is village current:", RoomManager.is_current(manager, "village"))
	print("Is forest current:", RoomManager.is_current(manager, "forest"))

	RoomManager.enter(manager, "forest")

	print("Current room after change:", RoomManager.get_current(manager))

	print("Is village current:", RoomManager.is_current(manager, "village"))
	print("Is forest current:", RoomManager.is_current(manager, "forest"))

	RoomManager.clear(manager)

	print("Current room after clear:", RoomManager.get_current(manager))
end