local GameplayObject = require "scripts.gameplay.gameplay_object"
local Health = require "scripts.gameplay.health"
local Inventory = require "scripts.gameplay.inventory"
local Stats = require "scripts.gameplay.stats"

function init(self)
	local player = GameplayObject.new()

	local health = Health.new(100)
	local inventory = Inventory.new()
	local stats = Stats.new()

	GameplayObject.add(player, "health", health)
	GameplayObject.add(player, "inventory", inventory)
	GameplayObject.add(player, "stats", stats)

	print("Has health:", GameplayObject.has(player, "health"))
	print("Has inventory:", GameplayObject.has(player, "inventory"))
	print("Has stats:", GameplayObject.has(player, "stats"))
	print("Has abilities:", GameplayObject.has(player, "abilities"))

	print("Health component exists:",
		GameplayObject.get(player, "health") ~= nil)

	print("Inventory component exists:",
		GameplayObject.get(player, "inventory") ~= nil)

	GameplayObject.remove(player, "inventory")

	print("Has inventory after remove:",
		GameplayObject.has(player, "inventory"))

	GameplayObject.clear(player)

	print("Has health after clear:",
		GameplayObject.has(player, "health"))

	print("Has stats after clear:",
		GameplayObject.has(player, "stats"))

	GameplayObject.add(player, "health", health)

	local player_health = GameplayObject.get(player, "health")

	print("Health before damage:",
		Health.get_current(player_health))

	Health.damage(player_health, 25)

	print("Health after damage:",
		Health.get_current(player_health))
	
end