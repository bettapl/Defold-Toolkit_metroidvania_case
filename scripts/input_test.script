local Input = require "scripts.core.input"

function init(self)
	print("INPUT TEST STARTED")
	
	local input = Input.new()

	Input.bind(input, "jump", hash("space"))
	Input.bind(input, "attack", hash("mouse_button_1"))
	Input.bind(input, "dash", hash("shift"))

	print("Has jump:", Input.has(input, "jump"))
	print("Has attack:", Input.has(input, "attack"))
	print("Has dash:", Input.has(input, "dash"))
	print("Has heal:", Input.has(input, "heal"))

	print("Jump binding:", Input.get_binding(input, "jump"))
	print("Attack binding:", Input.get_binding(input, "attack"))

	Input.unbind(input, "dash")

	print("Has dash after unbind:", Input.has(input, "dash"))

	Input.clear(input)

	print("Has jump after clear:", Input.has(input, "jump"))
	print("Has attack after clear:", Input.has(input, "attack"))
end