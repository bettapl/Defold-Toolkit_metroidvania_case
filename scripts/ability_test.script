local Ability = require "scripts.gameplay.ability"
local AbilityManager = require "scripts.gameplay.ability_manager"

function init(self)
	self.manager = AbilityManager.new()

	local dash = Ability.new("dash", function(data)
		print("Dash used:", data)
	end)

	AbilityManager.add(self.manager, dash)
	Ability.unlock(dash)

	AbilityManager.assign_slot(self.manager, 1, "dash")

	local used = AbilityManager.use_slot(self.manager, 1, "forward")

	print("Use slot result:", used)

	AbilityManager.assign_slot(self.manager, 1, "dash")

	print("Slot 1 before remove:", AbilityManager.get_slot(self.manager, 1))

	AbilityManager.remove(self.manager, "dash")

	print("Has dash after remove:", AbilityManager.has(self.manager, "dash"))
	print("Slot 1 after remove:", AbilityManager.get_slot(self.manager, 1))
	
	local success = pcall(function()
		AbilityManager.assign_slot(self.manager, 2, "missing")
	end)

	print("Assign missing ability success:", success)

	local empty_use = AbilityManager.use_slot(self.manager, 3, "test")

	print("Use empty slot:", empty_use)
end

function update(self, dt)
	AbilityManager.update(self.manager, dt)
end