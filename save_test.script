local Save = require "scripts.gameplay.save"

function init(self)
	local save = Save.new()

	Save.set(save, "health", 7)
	Save.set(save, "has_dash", true)

	Save.save_to_file(save, "test_save")

	local loaded_save = Save.new()

	Save.load_from_file(loaded_save, "test_save")

	print("Loaded health:", Save.get(loaded_save, "health"))
	print("Loaded dash:", Save.get(loaded_save, "has_dash"))

	print("Save exists:", Save.exists("test_save"))
	print("Missing save exists:", Save.exists("missing_save"))
end